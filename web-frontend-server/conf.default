server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index1.html;

  location / { try_files $uri $uri/ =404; }
  location ^~ /blog/ {
    alias /usr/share/nginx/html/blog/;
    index index2.html;
    autoindex off;
  }
  location /stub_status {
    stub_status on;
    allow all;
  }
}
